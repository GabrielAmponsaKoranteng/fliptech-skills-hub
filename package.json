{
  "name": "fliptech-skills-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=desktop --project=mobile",
    "e2e:ui": "playwright test --ui",
    "perf": "playwright test --project=perf --workers=1",
    "visual": "playwright test --project=visual-desktop --project=visual-phone",
    "visual:update": "playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.49.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
